{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creative-studio.invalid/v1/run-v1.schema.json",
  "title": "Durable run snapshot v1",
  "$comment": "Mutable materialized snapshot; events are append-only and sequence-numbered. Lease/fencing fields remain internal. Unknown charge is not zero. No automatic new paid generation after dispatch uncertainty; same-intent exact replay is permitted only when the frozen catalogue proves endpoint idempotency. A completed run has all required outputs in owned storage with byte hashes.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cs-run-v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "plan": {
      "$ref": "common.schema.json#/$defs/version_ref"
    },
    "compile_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_provider",
        "needs_reconciliation",
        "budget_blocked",
        "authorization_blocked",
        "cancel_requested",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "event_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "idempotency_key": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "admission_request_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "rerun": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selected_node_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "minItems": 1,
              "maxItems": 100
            },
            "downstream_node_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "minItems": 0,
              "maxItems": 100
            },
            "reuse": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/source_output"
              },
              "minItems": 0,
              "maxItems": 200
            },
            "authorised_by": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "required": [
            "selected_node_ids",
            "downstream_node_ids",
            "reuse",
            "authorised_by"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "queued",
              "running",
              "waiting_provider",
              "needs_reconciliation",
              "budget_blocked",
              "authorization_blocked",
              "succeeded",
              "failed",
              "cancelled",
              "skipped"
            ]
          },
          "attempt_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/asset_ref"
            },
            "minItems": 0,
            "maxItems": 40
          },
          "reused_from": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/source_output"
            },
            "minItems": 0,
            "maxItems": 40
          },
          "error": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/error"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "node_id",
          "state",
          "attempt_ids",
          "outputs",
          "reused_from",
          "error"
        ]
      },
      "minItems": 1,
      "maxItems": 200
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "node_id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "attempt_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "state": {
            "type": "string",
            "enum": [
              "prepared",
              "dispatching",
              "submitted",
              "waiting_provider",
              "ingesting",
              "succeeded",
              "failed",
              "uncertain",
              "cancel_requested",
              "cancelled"
            ]
          },
          "created_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "updated_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "node_input_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "request_sha256": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "idempotency_key": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "budget_reservation_id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_request_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "transport_bindings_sha256": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "dispatched_at": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "outputs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/asset_ref"
            },
            "minItems": 0,
            "maxItems": 40
          },
          "receipt_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "cost": {
            "$ref": "common.schema.json#/$defs/cost"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/error"
              },
              {
                "type": "null"
              }
            ]
          },
          "replay_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "provider_account_binding_id": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "dispatch_envelope_sha256": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "node_id",
          "attempt_number",
          "state",
          "created_at",
          "updated_at",
          "node_input_sha256",
          "request_sha256",
          "idempotency_key",
          "budget_reservation_id",
          "provider",
          "provider_request_id",
          "transport_bindings_sha256",
          "dispatched_at",
          "outputs",
          "receipt_ids",
          "cost",
          "error",
          "replay_count",
          "provider_account_binding_id",
          "dispatch_envelope_sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "cost": {
      "$ref": "common.schema.json#/$defs/cost"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/source_output"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "error": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "eligibility_receipt_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "id",
    "workspace_id",
    "created_at",
    "created_by",
    "updated_at",
    "plan",
    "compile_hash",
    "state",
    "event_sequence",
    "idempotency_key",
    "admission_request_sha256",
    "parent_run_id",
    "rerun",
    "nodes",
    "attempts",
    "cost",
    "outputs",
    "error",
    "eligibility_receipt_ids"
  ]
}
