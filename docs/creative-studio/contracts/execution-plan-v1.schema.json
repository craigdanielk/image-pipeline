{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creative-studio.invalid/v1/execution-plan-v1.schema.json",
  "title": "Frozen execution plan v1",
  "$comment": "compile_hash is SHA-256 of RFC8785 canonical UTF-8 program only. Source refs and exact artifact hash remain in the envelope for provenance. Only runtime transport binding may replace media slots with downloads/provider media IDs; prompts/models/parameters cannot be rewritten at runtime. Dependent provider calls reference predecessor output ports, whose actual bytes are recorded in node-input hashes at execution.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cs-execution-plan-v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "version_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "compile_hash_algorithm": {
      "const": "sha256-rfc8785-cs-program-v1"
    },
    "compile_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "cs-program-v1"
        },
        "compiler_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lowering_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "node_registry_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "catalogue_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "template_sha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_semantics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "treatment_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "recipe_graph_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "composition_sha256": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "request_sha256",
            "treatment_sha256",
            "recipe_graph_sha256",
            "composition_sha256"
          ]
        },
        "asset_inputs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/asset_ref"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "implementation_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/slug"
                },
                "minItems": 0,
                "maxItems": 100
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "port": {
                      "$ref": "common.schema.json#/$defs/slug"
                    },
                    "source": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "asset"
                            },
                            "asset": {
                              "$ref": "common.schema.json#/$defs/asset_ref"
                            }
                          },
                          "required": [
                            "kind",
                            "asset"
                          ]
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "kind": {
                              "const": "node_output"
                            },
                            "node_id": {
                              "$ref": "common.schema.json#/$defs/slug"
                            },
                            "port": {
                              "$ref": "common.schema.json#/$defs/slug"
                            },
                            "ordinal": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 99
                            }
                          },
                          "required": [
                            "kind",
                            "node_id",
                            "port",
                            "ordinal"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "port",
                    "source"
                  ]
                },
                "minItems": 0,
                "maxItems": 100
              },
              "provider_call": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "model_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "catalogue_entry_id": {
                        "$ref": "common.schema.json#/$defs/slug"
                      },
                      "endpoint_key": {
                        "$ref": "common.schema.json#/$defs/slug"
                      },
                      "adapter_version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "request_schema_sha256": {
                        "$ref": "common.schema.json#/$defs/sha256"
                      },
                      "positive_prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 30000
                      },
                      "negative_prompt": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 10000
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "parameters": {
                        "type": "object",
                        "maxProperties": 100
                      },
                      "media_bindings": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "field": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            "role": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            },
                            "input_port": {
                              "$ref": "common.schema.json#/$defs/slug"
                            },
                            "ordinal": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 99
                            }
                          },
                          "required": [
                            "field",
                            "role",
                            "input_port",
                            "ordinal"
                          ]
                        },
                        "minItems": 0,
                        "maxItems": 30
                      },
                      "seed": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4294967295
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "retries": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "automatic_resubmits": {
                            "const": 0
                          },
                          "transport_before_dispatch_max": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3
                          },
                          "same_intent_replay_max": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3
                          }
                        },
                        "required": [
                          "automatic_resubmits",
                          "transport_before_dispatch_max",
                          "same_intent_replay_max"
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "model_id",
                      "catalogue_entry_id",
                      "endpoint_key",
                      "adapter_version",
                      "request_schema_sha256",
                      "positive_prompt",
                      "negative_prompt",
                      "parameters",
                      "media_bindings",
                      "seed",
                      "retries"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "transform": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "operation": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "implementation_version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "parameters": {
                        "type": "object",
                        "maxProperties": 100
                      }
                    },
                    "required": [
                      "operation",
                      "implementation_version",
                      "parameters"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "output_contract": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "port": {
                      "$ref": "common.schema.json#/$defs/slug"
                    },
                    "media_kind": {
                      "type": "string",
                      "enum": [
                        "image",
                        "video",
                        "audio",
                        "composition",
                        "export"
                      ]
                    },
                    "mime_type": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "width_px": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1920
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "height_px": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1920
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "duration_frames": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 900
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "port",
                    "media_kind",
                    "mime_type",
                    "width_px",
                    "height_px",
                    "duration_frames"
                  ]
                },
                "minItems": 1,
                "maxItems": 20
              },
              "estimated_cost_micros": {
                "$ref": "common.schema.json#/$defs/money_micros"
              },
              "maximum_cost_micros": {
                "$ref": "common.schema.json#/$defs/money_micros"
              }
            },
            "required": [
              "id",
              "kind",
              "implementation_version",
              "dependencies",
              "inputs",
              "provider_call",
              "transform",
              "output_contract",
              "estimated_cost_micros",
              "maximum_cost_micros"
            ]
          },
          "minItems": 1,
          "maxItems": 200
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "node_id": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "port": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "format": {
                "$ref": "common.schema.json#/$defs/format"
              }
            },
            "required": [
              "id",
              "node_id",
              "port",
              "format"
            ]
          },
          "minItems": 1,
          "maxItems": 40
        },
        "budget_ceiling_micros": {
          "$ref": "common.schema.json#/$defs/money_micros"
        },
        "currency": {
          "const": "USD"
        }
      },
      "required": [
        "schema_version",
        "compiler_version",
        "lowering_version",
        "node_registry_sha256",
        "catalogue_sha256",
        "template_sha256",
        "source_semantics",
        "asset_inputs",
        "nodes",
        "outputs",
        "budget_ceiling_micros",
        "currency"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "common.schema.json#/$defs/version_ref"
        },
        "treatment": {
          "$ref": "common.schema.json#/$defs/version_ref"
        },
        "recipe": {
          "$ref": "common.schema.json#/$defs/version_ref"
        },
        "composition": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "brand_package": {
          "$ref": "common.schema.json#/$defs/version_ref"
        },
        "catalogue": {
          "$ref": "common.schema.json#/$defs/version_ref"
        }
      },
      "required": [
        "request",
        "treatment",
        "recipe",
        "composition",
        "brand_package",
        "catalogue"
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "common.schema.json#/$defs/budget"
        },
        "estimated_cost_micros": {
          "$ref": "common.schema.json#/$defs/money_micros"
        },
        "maximum_cost_micros": {
          "$ref": "common.schema.json#/$defs/money_micros"
        },
        "expires_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "required": [
        "budget",
        "estimated_cost_micros",
        "maximum_cost_micros",
        "expires_at"
      ]
    },
    "legacy_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "schema_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          },
          "legacy_compile_hash": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "schema_version",
          "sha256",
          "legacy_compile_hash"
        ]
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "id",
    "version_id",
    "revision",
    "workspace_id",
    "created_at",
    "created_by",
    "sha256",
    "compile_hash_algorithm",
    "compile_hash",
    "program",
    "sources",
    "admission",
    "legacy_artifacts"
  ]
}
