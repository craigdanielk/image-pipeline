{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.creative-studio.invalid/v1/creative-request-v1.schema.json",
  "title": "Creative Studio source request v1",
  "$comment": "Versioned source input for the existing compiler. Service/service_group must have physical_product_spec null; CAD/geometry is not mandatory for any offering. New physical constraints are only emitted when a real ProductSpec is present. MOS refs are validated by MOS API, not direct database reads. Request acceptance is not a publication approval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cs-creative-request-v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "version_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "created_by": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "standalone"
            },
            "direction_approval": {
              "$ref": "common.schema.json#/$defs/approval"
            }
          },
          "required": [
            "kind",
            "direction_approval"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "marketing-os"
            },
            "mos_workspace_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "campaign_brief": {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            "concept": {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            "concept_approval": {
              "$ref": "common.schema.json#/$defs/approval"
            },
            "placement": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/version_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "copy_versions": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/version_ref"
              },
              "minItems": 1,
              "maxItems": 30
            },
            "destination": {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            "claim_set": {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            "policy": {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            "brand_rule_revision": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/version_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "brand_rule_approval": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/approval"
                },
                {
                  "type": "null"
                }
              ]
            },
            "generation_eligibility": {
              "$ref": "common.schema.json#/$defs/eligibility_receipt"
            }
          },
          "required": [
            "kind",
            "mos_workspace_id",
            "campaign_brief",
            "concept",
            "concept_approval",
            "placement",
            "copy_versions",
            "destination",
            "claim_set",
            "policy",
            "brand_rule_revision",
            "brand_rule_approval",
            "generation_eligibility"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "$comment": "Marketing OS image library (LibraryPack visual_library item): an approved, offer-level image brief with no campaign concept, copy, claims or destination. exact_copy is empty; the treatment direction is the brief's own.",
          "properties": {
            "kind": {
              "const": "marketing-os-library"
            },
            "mos_workspace_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "library": {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            "library_item_key": {
              "type": "string",
              "pattern": "^lib-[A-Za-z0-9_:.-]{1,200}$"
            },
            "library_approval": {
              "$ref": "common.schema.json#/$defs/approval"
            },
            "policy": {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            "brand_rule_revision": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/version_ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "brand_rule_approval": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/approval"
                },
                {
                  "type": "null"
                }
              ]
            },
            "generation_eligibility": {
              "$ref": "common.schema.json#/$defs/eligibility_receipt"
            }
          },
          "required": [
            "kind",
            "mos_workspace_id",
            "library",
            "library_item_key",
            "library_approval",
            "policy",
            "brand_rule_revision",
            "brand_rule_approval",
            "generation_eligibility"
          ]
        }
      ]
    },
    "brand_package": {
      "$ref": "common.schema.json#/$defs/version_ref"
    },
    "offering": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "physical_product",
            "service",
            "service_group",
            "digital_product",
            "hybrid"
          ]
        },
        "source": {
          "$ref": "common.schema.json#/$defs/version_ref"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "value_propositions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 20
        },
        "approved_claims": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/version_ref"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "physical_product_spec": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/slug"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source": {
                "$ref": "common.schema.json#/$defs/version_ref"
              }
            },
            "required": [
              "id",
              "label",
              "value",
              "source"
            ]
          },
          "minItems": 0,
          "maxItems": 50
        }
      },
      "required": [
        "kind",
        "source",
        "name",
        "summary",
        "value_propositions",
        "approved_claims",
        "physical_product_spec",
        "service_facts"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "service",
                  "service_group"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "physical_product_spec": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "audiences": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/version_ref"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "exact_copy": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "role": {
            "type": "string",
            "enum": [
              "headline",
              "body",
              "cta",
              "caption",
              "disclaimer",
              "spoken",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 7000
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          },
          "source_copy": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/version_ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "claim_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/version_ref"
            },
            "minItems": 0,
            "maxItems": 30
          }
        },
        "required": [
          "id",
          "role",
          "text",
          "language",
          "source_copy",
          "claim_refs"
        ]
      },
      "minItems": 0,
      "maxItems": 50,
      "$comment": "At least one entry for every origin except marketing-os-library (image-library briefs carry no campaign copy); see allOf."
    },
    "formats": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/format"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/reference_input"
      },
      "minItems": 0,
      "maxItems": 100
    },
    "provider_selection": {
      "$ref": "common.schema.json#/$defs/provider_selection"
    },
    "budget": {
      "$ref": "common.schema.json#/$defs/budget"
    },
    "shot_spec": {
      "$comment": "Optional structured shot from the creative catalogue (mos-shot-spec-v1). When present the compiler builds a short photographic prompt from it instead of prose direction.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "catalogue_version", "format_id", "shot_id", "canvas", "slots", "client"],
      "properties": {
        "schema_version": {"const": "mos-shot-spec-v1"},
        "catalogue_version": {"type": "string", "minLength": 1, "maxLength": 40},
        "format_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "shot_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "canvas": {"type": "string", "minLength": 1, "maxLength": 16},
        "slots": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 400}, "maxProperties": 20},
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scene_palette", "style_line", "people_policy", "restrictions"],
          "properties": {
            "scene_palette": {"type": "array", "maxItems": 6, "items": {"type": "object", "additionalProperties": false,
              "required": ["hex", "object"], "properties": {"hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "object": {"type": "string", "minLength": 1, "maxLength": 80}}}},
            "style_line": {"type": "string", "maxLength": 300},
            "people_policy": {"type": "string", "maxLength": 40},
            "restrictions": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
          }
        },
        "references": {"type": "array", "maxItems": 20, "items": {"$ref": "common.schema.json#/$defs/sha256"}}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 100
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 100
        },
        "exact_logo_layers": {
          "const": true
        },
        "exact_copy_layers": {
          "const": true
        }
      },
      "required": [
        "forbidden",
        "required",
        "exact_logo_layers",
        "exact_copy_layers"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "version_id",
    "revision",
    "workspace_id",
    "created_at",
    "created_by",
    "sha256",
    "origin",
    "brand_package",
    "offering",
    "audiences",
    "objective",
    "hook",
    "locale",
    "exact_copy",
    "formats",
    "references",
    "provider_selection",
    "budget",
    "constraints"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "properties": {
              "kind": {
                "const": "marketing-os-library"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "exact_copy": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "exact_copy": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
