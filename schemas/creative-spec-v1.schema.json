{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aragon.services/image-pipeline/creative-spec-v1.schema.json",
  "title": "CreativeSpec v1",
  "description": "Per-campaign creative locks — scene, composition, prompt template. Changes per campaign, not per run.",
  "type": "object",
  "required": ["schema_version", "id", "product_spec_id", "prompt_template"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "creative-spec-v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "product_spec_id": { "type": "string" },
    "campaign_id": { "type": "string" },
    "prompt_template": { "type": "string" },
    "negative_template": { "type": "string" },
    "default_subject": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "scene_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "title", "invariants"],
        "properties": {
          "scene_id": { "type": "string" },
          "title": { "type": "string" },
          "invariants": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "run_invariants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Campaign-wide execution invariants applied to every run."
    },
    "kid_swap_invariants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Deprecated alias for run_invariants (consumer-specific cad.md naming)."
    },
    "default_composition": { "type": "string" },
    "default_background": { "type": "string" }
  }
}
