SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# AI prompt drafting in the job brief modal (POST /api/briefs/draft) uses the
# Claude Agent SDK, which drives the locally-authenticated `claude` CLI —
# your subscription, not a billed API key. No env var needed here; just
# `pip install -r ui/requirements.txt` and make sure `claude` is on PATH
# and logged in (same auth this session runs under).
